# Copy to .env in this directory. Optional.
HF_TOKEN=
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# CCV_HOME=.ccv

# Speech output for both runners (ccv TTS): paradee (default) or chatterbox, which needs nano_fast/serve.py running.
TTS=chatterbox
# CHATTERBOX_URL=http://127.0.0.1:8765

# Discord voice (discord-runner/index.mjs, the "discord" MCP server in .mcp.json).
# DISCORD_TOKEN=
# DISCORD_CHANNEL=https://discord.com/channels/<guild>/<voice-channel>
# DISCORD_END_SILENCE_MS=400
# DISCORD_JOIN_MS=1000
# DISCORD_PREBUFFER_MS=1000
# DISCORD_HOME=.discord
# DISCORD_SPEAK_PORT=8803

# Mic runner (mic-runner/index.mjs, the "mic" MCP server started by start-mic.sh). It listens to this machine's
# output audio and speaks replies into its microphone input. Keep each setting on its own line.
# Linux: PulseAudio/PipeWire source to listen to (default: the default output's monitor).
# MIC_LISTEN=
# Linux: sink that feeds the virtual microphone (default: the default output).
# MIC_SPEAK=
# MIC_END_SILENCE_MS=700
# MIC_ECHO_TAIL_MS=500
# MIC_JOIN_MS=1000
# MIC_SPEAKER_NAME=
# Full commands that replace the platform default: capture writes raw s16le 48 kHz mono, play reads raw s16le 24 kHz mono.
# MIC_CAPTURE_CMD=
# MIC_PLAY_CMD=

# WebRig runner (webrig-runner/index.mjs). The runner connects to WebRig's audio WebSocket.
# WEBRIG_WS_URL=ws://127.0.0.1:9888
# WEBRIG_SPEAK_PORT=8802
# WEBRIG_SPEAKER_NAME=webrig
# WEBRIG_HOME=.webrig
# WEBRIG_BRIDGE=1
# WEBRIG_END_SILENCE_MS=700
# WEBRIG_MIN_SPEECH_MS=250
# WEBRIG_MAX_UTTERANCE_MS=30000
# WEBRIG_VAD_THRESHOLD=0.5
# WEBRIG_VAD_RMS=120

# chatjimmy bridge (chatjimmy-bridge.mjs, run by start.mjs and by webrig-runner).
# CJ_NAME=Jenny
# CJ_HISTORY_CHARS=2500
# CJ_ECHO_WINDOW=1
# CCV_HOST_URL=http://127.0.0.1:8800

