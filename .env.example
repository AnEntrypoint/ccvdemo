# Copy to .env in this directory. Optional.
HF_TOKEN=
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Discord voice (discord-runner/index.mjs, the "discord" MCP server in .mcp.json).
# DISCORD_TOKEN=
# DISCORD_CHANNEL=https://discord.com/channels/<guild>/<voice-channel>
# DISCORD_END_SILENCE_MS=400
# DISCORD_HOME=.discord

# WebRig runner (webrig-runner/index.mjs). The runner connects to WebRig's audio WebSocket.
# WEBRIG_WS_URL=ws://127.0.0.1:9888
# WEBRIG_SPEAK_PORT=8802
# WEBRIG_SPEAKER_NAME=webrig
# WEBRIG_HOME=.webrig
# WEBRIG_BRIDGE=1

